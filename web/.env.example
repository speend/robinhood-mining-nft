# ---- 链选择 ----
# 31337 = 本地 Anvil（默认）；46630 = Robinhood Chain Testnet
NEXT_PUBLIC_CHAIN_ID=31337
# 留空则用内置默认：anvil=http://127.0.0.1:8545 / testnet=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL=
# 留空则用内置默认：anvil=null / testnet=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=

# ---- 合约地址（留空则从 deployments/anvil-31337.json 默认值读取）----
NEXT_PUBLIC_MINE_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_REWARDS_ADDRESS=

# ---- WalletConnect ----
# 无值时自动禁用 WalletConnect，只保留 injected 钱包
NEXT_PUBLIC_WC_PROJECT_ID=
